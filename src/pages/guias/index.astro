---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import CtaBand from '../../components/CtaBand.astro';
import Icon from '../../components/Icon.astro';
import { guides } from '../../data/guides';
import { UPGRADE_WA_MESSAGE } from '../../config/site';

const crumbs = [{ name: 'Início', href: '/' }, { name: 'Guias', href: '/guias/' }];
---
<BaseLayout
  title="Guias de Manutenção e Upgrade de Computadores | Muniz"
  description="Guias práticos para decidir sobre manutenção e upgrade de computadores e notebooks: SSD, memória RAM e o que verificar antes de comprar uma peça."
  breadcrumbs={crumbs}
  waMessage={UPGRADE_WA_MESSAGE}
  waRef="barra-mobile-guias"
>
  <section class="grid-bg-light border-b border-mist-200">
    <div class="container-site py-12 md:py-16">
      <Breadcrumbs items={crumbs} />
      <SectionHeading
        as="h1"
        eyebrow="Guias"
        title="Guias para decidir sobre o seu computador"
        lead="Explicações diretas para entender o que vale a pena antes de comprar uma peça ou trocar de equipamento."
      />
    </div>
  </section>

  <section class="container-site py-14 md:py-16" data-reveal>
    <ul class="grid gap-4 md:grid-cols-2">
      {guides.map((g) => (
        <li>
          <a href={`/guias/${g.slug}/`} class="card group flex h-full flex-col p-7 transition-[border-color,box-shadow,transform] duration-300 hover:-translate-y-0.5 hover:border-link/40 hover:shadow-[0_24px_50px_-30px_#0a254080]" data-reveal-item>
            <p class="font-mono text-xs text-link">{g.eyebrow.replace('Guia · ', '')}</p>
            <h2 class="mt-2 font-display text-2xl font-bold text-ink">{g.title}</h2>
            <p class="mt-3 flex-1 leading-relaxed text-muted">{g.description}</p>
            <span class="link-arrow mt-5 text-[0.95rem]">Ler o guia <Icon name="ArrowRight" size={16} class="transition-transform group-hover:translate-x-1" /></span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <CtaBand
    waRef="cta-final-guias"
    message={UPGRADE_WA_MESSAGE}
    title="Prefere perguntar direto?"
    text="Mande o modelo do computador ou notebook e o que está acontecendo pelo WhatsApp. Você recebe a orientação e o orçamento antes de qualquer serviço."
  />
</BaseLayout>
