---
import WhatsAppButton from './WhatsAppButton.astro';
interface Props { title?: string; text?: string; message?: string; waRef: string }
const {
  title = 'Conte o que está acontecendo. A resposta vem com o próximo passo.',
  text = 'Descreva o problema pelo WhatsApp. O caso é avaliado e você recebe o orçamento antes de começar.',
  message,
  waRef,
} = Astro.props;
---
<section class="container-site py-20" data-reveal>
  <div class="on-dark grid-bg relative overflow-hidden rounded-[1.75rem] bg-navy-900 px-6 py-12 sm:px-12 sm:py-16">
    <div aria-hidden="true" class="pointer-events-none absolute -right-24 -top-24 h-72 w-72 rounded-full bg-signal/20 blur-3xl"></div>
    <div class="relative grid items-center gap-8 lg:grid-cols-[1.4fr_1fr]">
      <div>
        <h2 class="font-display text-[1.9rem] font-bold leading-tight !text-white sm:text-[2.4rem]">{title}</h2>
        <p class="mt-4 max-w-xl text-lg leading-relaxed text-white/75">{text}</p>
      </div>
      <div class="flex flex-col gap-3 lg:items-end">
        <WhatsAppButton variant="signal" message={message} ref={waRef} label="Chamar no WhatsApp" class="w-full sm:w-auto" />
        <p class="font-mono text-xs text-white/60">Das 9h às 22h, todos os dias, conforme disponibilidade</p>
      </div>
    </div>
  </div>
</section>
