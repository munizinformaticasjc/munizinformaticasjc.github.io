---
import Icon from './Icon.astro';
import { waLink } from '../lib/whatsapp';

// kind: 'remoto' resolve a distância · 'misto' começa remoto · 'fisico' exige o equipamento
const problems = [
  { id: 'lento', label: 'Está lento', icon: 'Gauge', kind: 'misto', page: '/computador-lento/' },
  { id: 'virus', label: 'Vírus ou propagandas', icon: 'ShieldAlert', kind: 'remoto', page: '/remocao-de-virus/' },
  { id: 'windows', label: 'Erro no Windows', icon: 'AppWindow', kind: 'remoto', page: '/suporte-tecnico-windows/' },
  { id: 'travando', label: 'Trava ou reinicia', icon: 'RotateCcw', kind: 'misto', page: '/computador-travando/' },
  { id: 'formatar', label: 'Quero formatar', icon: 'RefreshCw', kind: 'misto', page: '/formatacao-de-notebook/' },
  { id: 'programa', label: 'Programa ou impressora', icon: 'Printer', kind: 'remoto', page: '/suporte-remoto/' },
  { id: 'esquentando', label: 'Esquenta muito', icon: 'Thermometer', kind: 'fisico', page: '/notebook-esquentando/' },
  { id: 'upgrade', label: 'Upgrade de SSD ou memória', icon: 'HardDrive', kind: 'fisico', page: '/upgrade-ssd/' },
] as const;

const data = JSON.stringify(problems.map(({ id, label, kind, page }) => ({ id, label, kind, page })));
---
<div class="diag card relative overflow-hidden shadow-[0_40px_80px_-40px_#0a254080]" data-diag>
  <div class="flex items-center justify-between border-b border-mist-200 bg-mist-50 px-5 py-3">
    <p class="font-mono text-xs font-medium text-muted">diagnóstico rápido</p>
    <ol class="flex items-center gap-1.5" aria-hidden="true">
      <li class="diag-dot h-1.5 w-6 rounded-full bg-link"></li>
      <li class="diag-dot h-1.5 w-6 rounded-full bg-mist-200"></li>
      <li class="diag-dot h-1.5 w-6 rounded-full bg-mist-200"></li>
    </ol>
  </div>

  <div class="p-5 sm:p-6" aria-live="polite">
    <!-- Passo 1 -->
    <fieldset data-step="1">
      <legend class="mb-4 font-display text-xl font-bold text-ink" tabindex="-1">O que está acontecendo com o computador?</legend>
      <div class="grid grid-cols-2 gap-2.5">
        {problems.map((p) => (
          <button type="button" data-problem={p.id} class="diag-opt group flex min-h-[3.4rem] items-center gap-2.5 rounded-xl border border-mist-200 bg-white px-3 py-2.5 text-left text-[0.95rem] font-semibold leading-tight text-ink transition-colors hover:border-link hover:bg-mist-50">
            <Icon name={p.icon} size={19} class="shrink-0 text-link transition-transform group-hover:scale-110" />
            {p.label}
          </button>
        ))}
      </div>
      <a href="/empresas/" class="link-arrow mt-4 text-sm">É para uma empresa? <Icon name="ArrowRight" size={15} /></a>
    </fieldset>

    <!-- Passo 2 -->
    <fieldset data-step="2" hidden>
      <legend class="mb-1 font-display text-xl font-bold text-ink" tabindex="-1">Onde você está?</legend>
      <p class="mb-4 text-sm text-muted">Isso define se o atendimento pode ser físico ou só remoto.</p>
      <div class="grid gap-2.5">
        <button type="button" data-place="sjc" class="diag-opt flex items-center gap-3 rounded-xl border border-mist-200 bg-white px-4 py-3.5 text-left font-semibold text-ink transition-colors hover:border-link hover:bg-mist-50">
          <Icon name="MapPin" size={20} class="text-link" /> Em São José dos Campos
        </button>
        <button type="button" data-place="outra" class="diag-opt flex items-center gap-3 rounded-xl border border-mist-200 bg-white px-4 py-3.5 text-left font-semibold text-ink transition-colors hover:border-link hover:bg-mist-50">
          <Icon name="Globe" size={20} class="text-link" /> Em outra cidade do Brasil
        </button>
      </div>
      <button type="button" data-back class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-muted hover:text-link">
        <Icon name="ArrowLeft" size={15} /> Voltar
      </button>
    </fieldset>

    <!-- Passo 3 -->
    <div data-step="3" hidden>
      <p class="font-mono text-xs text-muted" data-out-problem></p>
      <h2 class="mt-1 font-display text-xl font-bold text-ink" tabindex="-1" data-out-title></h2>
      <ul class="mt-4 space-y-2.5" data-out-steps></ul>
      <a href={waLink()} target="_blank" rel="noopener" data-wa="diagnostico" data-out-wa class="btn btn-primary mt-6 w-full">
        <Icon name="MessageCircle" size={20} /> <span data-out-cta>Enviar pelo WhatsApp</span>
      </a>
      <p class="mt-2 text-center text-xs text-muted">A mensagem já vai preenchida. É só revisar e enviar.</p>
      <div class="mt-4 flex items-center justify-between text-sm">
        <button type="button" data-restart class="inline-flex items-center gap-1 font-semibold text-muted hover:text-link">
          <Icon name="RotateCcw" size={15} /> Recomeçar
        </button>
        <a href="/" data-out-page class="link-arrow">Sobre este serviço <Icon name="ArrowRight" size={15} /></a>
      </div>
    </div>

    <noscript>
      <p class="mt-4 text-sm text-muted">Ative o JavaScript para usar o diagnóstico ou <a class="link-arrow" href={waLink(undefined, 'diagnostico-noscript')} target="_blank" rel="noopener" data-wa="diagnostico-noscript">fale direto pelo WhatsApp</a>.</p>
    </noscript>
  </div>

  <template data-check-tpl>
    <li class="flex items-start gap-3 text-[0.97rem] leading-snug text-body">
      <span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-ok-deep text-white">
        <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5" /></svg>
      </span>
      <span></span>
    </li>
  </template>
  <script type="application/json" data-problems set:html={data} />
</div>

<script>
  import { stagger } from 'motion';
  import { animate } from 'motion/mini';
  import { site, DEFAULT_WA_MESSAGE } from '../config/site';

  type Kind = 'remoto' | 'misto' | 'fisico';
  type Problem = { id: string; label: string; kind: Kind; page: string };
  type Place = 'sjc' | 'outra';

  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  function outcome(p: Problem, place: Place) {
    const sjc = place === 'sjc';
    if (p.kind === 'remoto') {
      return {
        title: 'Esse tipo de problema costuma ser tratado por suporte remoto.',
        steps: [
          'Você descreve o problema pelo WhatsApp.',
          'O caso é avaliado e você recebe o orçamento antes de começar.',
          'No horário marcado, autoriza a conexão e acompanha tudo na tela.',
        ],
        intent: 'Gostaria de agendar um suporte remoto.',
        cta: 'Agendar suporte remoto',
      };
    }
    if (p.kind === 'misto') {
      return {
        title: 'O primeiro passo costuma ser remoto.',
        steps: [
          'Quando possível, a causa é investigada a distância.',
          'Se for algo no sistema, a solução segue pelo remoto.',
          sjc
            ? 'Se exigir manutenção física, o equipamento é entregue em local combinado em São José dos Campos, mediante agendamento.'
            : 'Se a causa for física, você recebe a orientação do que precisa ser verificado por um técnico próximo.',
        ],
        intent: 'Gostaria de uma avaliação.',
        cta: 'Pedir avaliação',
      };
    }
    return sjc
      ? {
          title: 'Esse caso precisa do equipamento em mãos.',
          steps: [
            'Você conta o que está acontecendo pelo WhatsApp.',
            'O caso é avaliado e você recebe o orçamento antes de começar.',
            'O equipamento é entregue em local combinado em São José dos Campos, mediante agendamento.',
          ],
          intent: 'Gostaria de combinar a entrega do equipamento para avaliação.',
          cta: 'Combinar avaliação',
        }
      : {
          title: 'Esse serviço é físico, feito só em São José dos Campos.',
          steps: [
            'Uma verificação remota pode mostrar se a causa é mesmo física.',
            'Se for, o serviço depende de levar o equipamento até São José dos Campos.',
            'Pelo WhatsApp, você entende as opções antes de decidir.',
          ],
          intent: 'Estou em outra cidade e gostaria de entender as opções.',
          cta: 'Tirar dúvidas',
        };
  }

  function waUrl(message: string) {
    return `https://wa.me/${site.whatsapp}?text=${encodeURIComponent(message)}`;
  }

  document.querySelectorAll<HTMLElement>('[data-diag]').forEach((root) => {
    const problems: Problem[] = JSON.parse(root.querySelector('[data-problems]')!.textContent || '[]');
    const steps = [1, 2, 3].map((n) => root.querySelector<HTMLElement>(`[data-step="${n}"]`)!);
    const dots = root.querySelectorAll<HTMLElement>('.diag-dot');
    const tpl = root.querySelector<HTMLTemplateElement>('[data-check-tpl]')!;
    let problem: Problem | undefined;

    function go(n: number) {
      steps.forEach((s, i) => (s.hidden = i !== n - 1));
      dots.forEach((d, i) => {
        d.classList.toggle('bg-link', i < n);
        d.classList.toggle('bg-mist-200', i >= n);
      });
      const current = steps[n - 1];
      current.querySelector<HTMLElement>('legend, h2')?.focus({ preventScroll: true });
      if (!reduce) animate(current, { opacity: [0, 1], transform: ['translateX(12px)', 'none'] }, { duration: 0.35, ease: [0.25, 1, 0.5, 1] });
    }

    root.querySelectorAll<HTMLButtonElement>('[data-problem]').forEach((btn) =>
      btn.addEventListener('click', () => {
        problem = problems.find((p) => p.id === btn.dataset.problem);
        go(2);
      }),
    );

    root.querySelectorAll<HTMLButtonElement>('[data-place]').forEach((btn) =>
      btn.addEventListener('click', () => {
        if (!problem) return go(1);
        const place = btn.dataset.place as Place;
        const out = outcome(problem, place);
        root.querySelector('[data-out-problem]')!.textContent = `${problem.label} · ${place === 'sjc' ? 'São José dos Campos' : 'outra cidade'}`;
        root.querySelector('[data-out-title]')!.textContent = out.title;
        root.querySelector('[data-out-cta]')!.textContent = out.cta;
        root.querySelector<HTMLAnchorElement>('[data-out-page]')!.href = problem.page;

        const list = root.querySelector<HTMLUListElement>('[data-out-steps]')!;
        list.replaceChildren(
          ...out.steps.map((text) => {
            const li = tpl.content.firstElementChild!.cloneNode(true) as HTMLLIElement;
            li.querySelector('span:last-child')!.textContent = text;
            return li;
          }),
        );

        const message = [
          'Olá! Vim pelo site da Muniz Informática.',
          `Problema: ${problem.label}`,
          `Local: ${place === 'sjc' ? 'São José dos Campos' : 'outra cidade (informar qual)'}`,
          out.intent,
          'Melhor dia e horário para mim:',
          '',
          `(ref: diagnostico-${problem.id})`,
        ].join('\n');
        const wa = root.querySelector<HTMLAnchorElement>('[data-out-wa]')!;
        wa.href = waUrl(message);
        wa.dataset.wa = `diagnostico-${problem.id}`;

        go(3);
        if (!reduce) {
          animate(Array.from(list.children), { opacity: [0, 1], transform: ['translateX(-8px)', 'none'] }, { duration: 0.4, delay: stagger(0.15, { startDelay: 0.15 }) });
        }
      }),
    );

    root.querySelector('[data-back]')?.addEventListener('click', () => go(1));
    root.querySelector('[data-restart]')?.addEventListener('click', () => {
      problem = undefined;
      go(1);
    });
    // Mantém o link padrão caso alguém clique antes de concluir.
    root.querySelector<HTMLAnchorElement>('[data-out-wa]')!.href = waUrl(DEFAULT_WA_MESSAGE);
  });
</script>
