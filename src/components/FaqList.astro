---
import Icon from './Icon.astro';
interface Props { faqs: [string, string][] }
const { faqs } = Astro.props;
---
<div class="space-y-3">
  {faqs.map(([q, a]) => (
    <details class="faq card group px-5 sm:px-6" data-reveal-item>
      <summary class="flex items-center justify-between gap-4 py-5 font-display text-lg font-semibold text-ink">
        {q}
        <span class="faq-icon flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-mist-100 text-link"><Icon name="Plus" size={18} /></span>
      </summary>
      <p class="pb-5 leading-relaxed text-body">{a}</p>
    </details>
  ))}
</div>
